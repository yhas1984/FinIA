# Configuración del backend de verificación de compras (NO commitear).
# Copia este archivo a .env y rellena los valores reales.
# El script scripts/build_release.sh lo carga automáticamente.

FINAI_BILLING_BACKEND_URL=
FINAI_BILLING_ENTITLEMENT_ISSUER=finai-billing
FINAI_BILLING_ENTITLEMENT_KEY_ID=2026-01
FINAI_BILLING_ENTITLEMENT_PUBLIC_KEY_PEM=
FINAI_BILLING_BACKEND_REQUIRED=true
FINAI_BILLING_PLAY_INTEGRITY_ENABLED=false
